
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  category    String
  price       Int
  image       String
  images String[] @default([])
  description String
  sizes       String[]
  colors      String[]
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems OrderItem[]
  
}
model Admin {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Order {
  id           Int         @id @default(autoincrement())
  orderNumber  String      @unique

  customerName String
  phone        String
  district     String
  address      String

  deliveryZone String
  deliveryFee  Int

  subtotal     Int
  total        Int

  paymentMethod String     @default("COD")
  status        String     @default("PENDING")

  items        OrderItem[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model OrderItem {
  id          Int      @id @default(autoincrement())

  orderId     Int
  productId   Int?

  productName String
  unitPrice   Int
  size        String
  color       String
  quantity    Int
  lineTotal   Int

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model StoreSettings {
  id           Int      @id @default(1)
  storeName    String   @default("Aklima Fashion House")
  logoUrl      String?
  logoPublicId String?
  updatedAt    DateTime @updatedAt
}